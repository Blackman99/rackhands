# Simulated BMC for CI (test/integration.sh replaces @STATE@; sensor values are polled
# from files there): two temperature sensors (one above its non-critical
# threshold), a fan, a SEL with three events, and product FRU data.
mc_setbmc 0x20
mc_add 0x20 0 no-device-sdrs 0x23 9 8 0x9f 0x2a7c 0x0b7f persist_sdr
sel_enable 0x20 1000 0x0a
sensor_add 0x20 0 1 0x01 0x01 poll 1000 file "@STATE@/sensor1"
sensor_set_threshold 0x20 0 1 settable 111000 0xa0 0x90 0x70 00 00 00
sensor_set_event_support 0x20 0 1 enable scanning per-state 000111111000000 000111111000000 000111111000000 000111111000000
sensor_add 0x20 0 2 0x01 0x01 poll 1000 file "@STATE@/sensor2"
sensor_set_threshold 0x20 0 2 settable 111000 0xa0 0x90 0x70 00 00 00
sensor_set_event_support 0x20 0 2 enable scanning per-state 000111111000000 000111111000000 000111111000000 000111111000000
sensor_add 0x20 0 3 0x04 0x01 poll 1000 file "@STATE@/sensor3"
sensor_set_threshold 0x20 0 3 settable 111000 0xa0 0x90 0x70 00 00 00
sensor_set_event_support 0x20 0 3 enable scanning per-state 000111111000000 000111111000000 000111111000000 000111111000000
main_sdr_add 0x20 0x01 0x00 0x51 0x01 0x33 0x20 0x00 0x01 0x03 0x01 0x7f 0x48 0x01 0x01 0x00 0x00 0x00 0x00 0x3f 0x3f 0x00 0x01 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xff 0x00 0xa0 0x90 0x70 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc8 0x43 0x50 0x55 0x20 0x54 0x65 0x6d 0x70
main_sdr_add 0x20 0x02 0x00 0x51 0x01 0x34 0x20 0x00 0x02 0x0a 0x01 0x7f 0x48 0x01 0x01 0x00 0x00 0x00 0x00 0x3f 0x3f 0x00 0x01 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xff 0x00 0xa0 0x90 0x70 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc9 0x50 0x53 0x55 0x32 0x20 0x54 0x65 0x6d 0x70
main_sdr_add 0x20 0x03 0x00 0x51 0x01 0x2f 0x20 0x00 0x03 0x1d 0x01 0x7f 0x48 0x04 0x01 0x00 0x00 0x00 0x00 0x3f 0x3f 0x00 0x12 0x00 0x00 0x32 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xff 0x00 0xa0 0x90 0x70 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc4 0x46 0x41 0x4e 0x31
# SEL: timestamp 2026-10-01; generator 0x20; sensor type/number; event type; data
sel_add 0x20 0x02 0x00 0x7d 0xdc 0x68 0x20 0x00 0x04 0x01 0x02 0x01 0x07 0x75 0x70
sel_add 0x20 0x02 0x80 0x7e 0xdc 0x68 0x20 0x00 0x04 0x08 0x05 0x6f 0x01 0xff 0xff
sel_add 0x20 0x02 0x00 0x80 0xdc 0x68 0x20 0x00 0x04 0x04 0x03 0x01 0x02 0x30 0x40
# FRU device 0: product info area
mc_add_fru_data 0x20 0 72 data 0x01 0x00 0x00 0x00 0x01 0x00 0x00 0xfe 0x01 0x08 0x00 0xca 0x53 0x75 0x70 0x65 0x72 0x6d 0x69 0x63 0x72 0x6f 0xcd 0x53 0x59 0x53 0x2d 0x31 0x30 0x32 0x39 0x50 0x2d 0x53 0x49 0x4d 0xc6 0x58 0x31 0x31 0x44 0x50 0x55 0xc3 0x31 0x2e 0x30 0xcf 0x53 0x34 0x31 0x31 0x37 0x39 0x34 0x58 0x30 0x41 0x31 0x32 0x33 0x34 0x35 0xc0 0xc0 0xc1 0x00 0x00 0x00 0x00 0x00 0xb9
mc_enable 0x20
